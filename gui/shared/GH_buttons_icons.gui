types GHButtonIcons
{
	### Icon buttons 60px
	type button_biography = button_icon
	{
		texture = "gfx/interface/icons/flat_icons/pin.dds"
		framesize = { 60 60 }
	}
	type button_purge_county = button_icon
	{
		framesize = { 70 60 }
		texture = "gfx/interface/icons/flat_icons/prison_execute.dds"
	}
	
	type button_increase_society_power = button_icon
	{
		framesize = { 70 60 }
		texture = "gfx/interface/icons/flat_icons/plus.dds"
	}
	
	type button_decrease_society_power = button_icon
	{
		framesize = { 70 60 }
		texture = "gfx/interface/icons/flat_icons/minus.dds"
	}
	type button_demote_title = button_icon
	{
		texture = "gfx/interface/icons/title_actions/demote_title.dds"
	}
}
