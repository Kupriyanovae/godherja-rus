			## Mana & Gold Cost
			block "header_content" {
				text_single = {
					raw_text = "Standard"
					using = Font_Size_Medium
					default_format = "#V"
				}
			}
			
			text_single = {
				raw_text = "#V [gold_i][Story.MakeScope.Var('spell_being_prepared').Story.MakeScope.Var('spell_gold_cost').GetValue|0]@magic_icon![Story.MakeScope.Var('spell_being_prepared').Story.MakeScope.Var('spell_cost').GetValue|0]#!"
				using = Font_Size_Small
				align = left|bottom
				fontsize = 12
			}
			
			## Aspect Changes
