	type scrollarea_province_aspect_values = scrollarea {
		min_width = 232

		scrollbarpolicy_vertical = always_off
		scrollbarpolicy_horizontal = as_needed
		
		scrollbar_horizontal = {
			scrollbar = {
				wheelstep = 60
				direction = horizontal

				track = {
					button = {}
				}

				slider = {
					button = {}
				}

				dec_button = {

					button = {}
				}

				inc_button = {
					button = {}
				}
			}
		}
		scrollwidget = {
			hbox = {
				layoutpolicy_horizontal = expanding
				expand = {}
