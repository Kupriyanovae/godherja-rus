						tooltip = "[GetScriptedGui('increase_devotion_level_3_patron_saint_scripted_gui').BuildTooltip(GuiScope.SetRoot(Scope.GetProvince.MakeScope).AddScope('player_viewing_patron_saints',GetPlayer.MakeScope).End)]"
						blockoverride "level_text" {
							raw_text = "III"
						}
						blockoverride "color_alpha" {
							alpha = 0.5
						}
					}
					
					button_patron_saint_level = {
						visible = "[Not(GetScriptedGui('character_has_level_or_above_patron_saint_check').IsShown(GuiScope.SetRoot(Scope.GetProvince.MakeScope).AddScope('player_viewing_patron_saints',GetPlayer.MakeScope).AddScope('patron_saint_level_being_checked',MakeScopeValue('(CFixedPoint)4')).End))]"
						enabled = "[GetScriptedGui('increase_devotion_level_4_patron_saint_scripted_gui').IsValid(GuiScope.SetRoot(Scope.GetProvince.MakeScope).AddScope('player_viewing_patron_saints',GetPlayer.MakeScope).End)]"
						onclick = "[GetScriptedGui('increase_devotion_level_4_patron_saint_scripted_gui').Execute(GuiScope.SetRoot(Scope.GetProvince.MakeScope).AddScope('player_viewing_patron_saints',GetPlayer.MakeScope).End)]"
						tooltip = "[GetScriptedGui('increase_devotion_level_4_patron_saint_scripted_gui').BuildTooltip(GuiScope.SetRoot(Scope.GetProvince.MakeScope).AddScope('player_viewing_patron_saints',GetPlayer.MakeScope).End)]"
						blockoverride "glow_visibility" {
							visible = "[GetScriptedGui('increase_devotion_level_4_patron_saint_scripted_gui').IsValid(GuiScope.SetRoot(Scope.GetProvince.MakeScope).AddScope('player_viewing_patron_saints',GetPlayer.MakeScope).End)]"
						}
						blockoverride "level_text" {
							raw_text = "IV"
						}
					}
					button_patron_saint_level = {
						visible = "[GetScriptedGui('character_has_level_or_above_patron_saint_check').IsShown(GuiScope.SetRoot(Scope.GetProvince.MakeScope).AddScope('player_viewing_patron_saints',GetPlayer.MakeScope).AddScope('patron_saint_level_being_checked',MakeScopeValue('(CFixedPoint)4')).End)]"
						tooltip = "[GetScriptedGui('increase_devotion_level_4_patron_saint_scripted_gui').BuildTooltip(GuiScope.SetRoot(Scope.GetProvince.MakeScope).AddScope('player_viewing_patron_saints',GetPlayer.MakeScope).End)]"
						blockoverride "level_text" {
