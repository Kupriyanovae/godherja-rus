			visible = "[GetVariableSystem.Exists(Concatenate(Scope.GetProvince.GetNameNoTooltip,'_patrons_displayed'))]"
			datamodel_wrap = 4
			ignoreinvisible = yes
			flipdirection = yes
			
			item = {
				container = {
					datacontext = "[Scope.GetCharacter]"
		
					portrait_head = {
						
					}
				}
			}
		}
	}

