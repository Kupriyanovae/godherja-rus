			hbox = {
				hbox = {
					datamodel = "[Scope.GetProvince.MakeScope.GetList('patron_saint_patron_character_list')]"
					visible = "[DataModelHasItems( Scope.GetProvince.MakeScope.GetList('patron_saint_patron_character_list') )]"
					
					item = {
						container = {
							datacontext = "[Scope.GetCharacter]"
				
							portrait_head = {
								name = "character_portrait_patron_saint"
								datacontext = "[Scope.GetCharacter]"
	
								blockoverride "coa" {}
								blockoverride "opinion_box"{}
							}
						}
					}
				}
				
				expand = {}
			}
		}
		
		spacer = {
			size = { 0 150 }
		}
		
		hbox = {
			layoutpolicy_horizontal = expanding
			spacing = 10
			text_multi = {
				text = "[Localize(Concatenate(Scope.Var('patron_saint_name').GetFlagName,'_desc'))]"
				visible = "[Not(EqualTo_string(Localize(Concatenate(Scope.Var('patron_saint_name').GetFlagName,'_desc')), Concatenate(Scope.Var('patron_saint_name').GetFlagName,'_desc')))]"
				max_width = 330
				layoutpolicy_horizontal = expanding
				align = left
				autoresize = yes
			}
			
			divider_light = {
				layoutpolicy_vertical = expanding
			}
			
			vbox = {
				hbox = {
					datamodel = "[Scope.GetList('patron_saint_skills_ui')]"
					item = {
						hbox = {
							margin_left = 10
							margin_right = 15
							spacing = 4
						
							background = {
								texture = "gfx/interface/window_character/character_view_skills_bg.dds"
								framesize = { 70 26 }
								frame = "[Select_int32( EqualTo_string(Scope.GetFlagName,'diplomacy_skill') , '(int32)1', Select_int32(EqualTo_string(Scope.GetFlagName,'martial_skill'),'(int32)2', Select_int32(Or(EqualTo_string(Scope.GetFlagName,'stewardship_skill'), EqualTo_string(Scope.GetFlagName,'health_skill')),'(int32)3', Select_int32(EqualTo_string(Scope.GetFlagName, 'intrigue_skill'), '(int32)4' , Select_int32(EqualTo_string(Scope.GetFlagName, 'learning_skill'), '(int32)5', '(int32)6')) ) ) )]"
							}
						
							icon = {
								texture = "gfx/interface/icons/icon_skills.dds"
								framesize = { 60 60 }
								frame = "[Select_int32( EqualTo_string(Scope.GetFlagName,'diplomacy_skill') , '(int32)1', Select_int32(EqualTo_string(Scope.GetFlagName,'martial_skill'),'(int32)2', Select_int32(EqualTo_string(Scope.GetFlagName,'stewardship_skill'),'(int32)3', Select_int32(EqualTo_string(Scope.GetFlagName, 'intrigue_skill'), '(int32)4' , Select_int32(EqualTo_string(Scope.GetFlagName, 'learning_skill'), '(int32)5', '(int32)6')) ) ) )]"
								size = { 30 30 }
							}
							
							text_single = {
								using = Font_Size_Small
								text = "[Province.MakeScope.Var(Concatenate(Concatenate('patron_saint_',Scope.GetFlagName),'_affinity_modifier')).GetValue]"
								default_format = "#high"
							}
						}
					}
				}
				
				hbox = {
					layoutpolicy_horizontal = expanding
					fixedgridbox = {
						datamodel = "[Scope.GetList('patron_saint_traits')]"
						flipdirection = yes
						datamodel_wrap = 5
						addcolumn = 40
						addrow = 80
						
						item = {
							container_patron_saint_trait_modifier = { }
						}
					}
					expand = {}
				}
				
				vbox = {
					datamodel = "[Scope.GetList('patron_saint_aspects')]"
					
					item = {
						text_multi = {
							text = "[Localize(Concatenate(Scope.GetFlagName, '_desc'))]"
							max_width = 250
							margin_right = 20
							autoresize = yes
						}
					}
				}
				
				vbox = {
					datamodel = "[Scope.GetList('patron_saint_holy_sites_list')]"
					layoutpolicy_horizontal = expanding
					
					text_single = {
						raw_text = "Святые места"
						
						layoutpolicy_horizontal = expanding
						align = left
						
						using = Font_Size_Small
						default_format = "#bold"
					}
					
					item = {
						hbox = {
							layoutpolicy_horizontal = expanding
							
							text_single = {
								text = "[Scope.Title.GetBaseNameNoTier]"
							}
							
							coa_title_tiny = {
								datacontext = "[Scope.Title]"
							}
						}
					}
				}
			}
			
			expand = {}
		}
		
