									min_width = 300
									max_width = 300
									multiline = yes
									autoresize = yes
								}
								vbox = {
									datacontext = "[Scope.Var('judge_character').GetCharacter]"
									max_width = 260
								
									layoutpolicy_horizontal = expanding
