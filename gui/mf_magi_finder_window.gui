								layoutpolicy_horizontal = expanding
								margin_right = 36
								text = "membership_filter_category"
								align = center
							}
						}

						vbox = {
							visible = "[Not(GetVariableSystem.Exists('mf_expand_group_filter_list'))]"
							layoutpolicy_horizontal = expanding
							spacing = 5
							margin_top = 5

							### LIST OF FILTERS ###
							hbox_filter_label_and_dropdown = {
								blockoverride "text"
								{
									text = "[Localize('religion_filter')]"
								}
								blockoverride "dropd"
								{
									#RELIGION FILTER
									dropdown_menu_standard = {

										# Size of the button itself and the max list height
										blockoverride "dropdown_size" { size = { 220 32 } }
										blockoverride "dropdown_list_maxsize" { maximumsize = { 260 260 } }

										# Feed it the list + tell it what to do when a choice is picked
										blockoverride "dropdown_properties" {
											datamodel = "[GetPlayer.MakeScope.GetList('mf_filter_list_religion')]"
											onselectionchanged = "[PdxGuiWidget.FindChild('dropdown_active').TriggerAnimation('apply_filter_choice')]"
										}

										# What the closed button shows (pick static or dynamic)
										blockoverride "dropdown_active_item_properties" {
											name = "dropdown_active"
											text = "[Localize(Concatenate(GetPlayer.MakeScope.Var('mf_filters_search_magi_religion').GetFlagName,'_loc'))]"

											state = {
												name = apply_filter_choice
												# Dispatch by the selected flag name; easiest is to call a tiny SGUI
												on_finish = "[GetScriptedGui('mf_dropdown_selection').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('mf_religion', MakeScopeFlag(Scope.GetFlagName)).End)]"
											}
										}

										# How each row is labeled
										blockoverride "dropdown_item_properties" {
											text = "[Localize(Concatenate(Scope.GetFlagName,'_loc'))]"
										}
									}
								}
							}
							hbox_filter_label_and_dropdown = {
								blockoverride "text"
								{
									text = "[Localize('culture_filter')]"
								}
								blockoverride "dropd"
								{
									#CULTURE FILTER
									dropdown_menu_standard = {

										# Size of the button itself and the max list height
										blockoverride "dropdown_size" { size = { 220 32 } }
										blockoverride "dropdown_list_maxsize" { maximumsize = { 260 260 } }

										# Feed it the list + tell it what to do when a choice is picked
										blockoverride "dropdown_properties" {
											datamodel = "[GetPlayer.MakeScope.GetList('mf_filter_list_culture')]"
											onselectionchanged = "[PdxGuiWidget.FindChild('dropdown_active').TriggerAnimation('apply_filter_choice')]"
										}

										# What the closed button shows (pick static or dynamic)
										blockoverride "dropdown_active_item_properties" {
											name = "dropdown_active"
											text = "[Localize(Concatenate(GetPlayer.MakeScope.Var('mf_filters_search_magi_culture').GetFlagName,'_loc'))]"

											state = {
												name = apply_filter_choice
												# Dispatch by the selected flag name; easiest is to call a tiny SGUI
												on_finish = "[GetScriptedGui('mf_dropdown_selection').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('mf_culture', MakeScopeFlag(Scope.GetFlagName)).End)]"
											}
										}

										# How each row is labeled
										blockoverride "dropdown_item_properties" {
											text = "[Localize(Concatenate(Scope.GetFlagName,'_loc'))]"
										}
									}
								}
							}
							hbox_filter_label_and_dropdown = {
								blockoverride "text"
								{
									text = "[Localize('dynasty_filter')]"
								}
								blockoverride "dropd"
								{
									#DYNASTY FILTER
									dropdown_menu_standard = {

										# Size of the button itself and the max list height
										blockoverride "dropdown_size" { size = { 220 32 } }
										blockoverride "dropdown_list_maxsize" { maximumsize = { 260 260 } }

										# Feed it the list + tell it what to do when a choice is picked
										blockoverride "dropdown_properties" {
											datamodel = "[GetPlayer.MakeScope.GetList('mf_filter_list_dynasty')]"
											onselectionchanged = "[PdxGuiWidget.FindChild('dropdown_active').TriggerAnimation('apply_filter_choice')]"
										}

										# What the closed button shows (pick static or dynamic)
										blockoverride "dropdown_active_item_properties" {
											name = "dropdown_active"
											text = "[Localize(Concatenate(GetPlayer.MakeScope.Var('mf_filters_search_magi_dynasty').GetFlagName,'_loc'))]"

											state = {
												name = apply_filter_choice
												# Dispatch by the selected flag name; easiest is to call a tiny SGUI
												on_finish = "[GetScriptedGui('mf_dropdown_selection').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('mf_dynasty', MakeScopeFlag(Scope.GetFlagName)).End)]"
											}
										}

										# How each row is labeled
										blockoverride "dropdown_item_properties" {
											text = "[Localize(Concatenate(Scope.GetFlagName,'_loc'))]"
										}
									}
								}
							}
						}
					}
				}
			}

			hbox = {
				layoutpolicy_horizontal = growing
				margin_bottom = 10

				button_standard = {
					text = "CHARACTER_RESET_FILTERS"
					tooltip = "mf_CHARACTER_RESET_FILTERS_tooltip"
					using = tooltip_nw
					focuspolicy = click
					onclick = "[GetScriptedGui('mf_reload_to_basics').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				}
			}
		}
	}
}

Types Window_Magi_Search {
	type hbox_filter_label_and_dropdown = hbox {
		margin_top = 3
		margin_bottom = 10
		layoutpolicy_horizontal = expanding
		text_single = {
			block "text" {}
		}
		expand = {}
		block "dropd" {}
	}
}
